{
  "version": 2,
  "builds": [
    {
      "src": "dist/Angular-MovieTicketBooking/**/*",
      "use": "@vercel/static"
    },
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "/server.js" },
    { "src": "/(.*)", "dest": "/dist/Angular-MovieTicketBooking/index.html" }
  ]
}
